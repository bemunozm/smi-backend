# Copiar este archivo a `.env` y completar los valores para desarrollo local.
# NUNCA commitear el archivo `.env` real (ya está en .gitignore).

# --- Base de datos (Postgres via docker-compose) ---
# Puerto 5433 en el host (no 5432): evita choque con otros contenedores
# Postgres que puedan estar corriendo localmente. Ver docker-compose.yml.
DATABASE_URL="postgresql://smi_user:smi_password@localhost:5433/smi_db?schema=public"

# --- Better Auth ---
# Genera un secreto fuerte y único con: openssl rand -base64 32
# Nunca reutilizar este valor de ejemplo en un entorno real.
BETTER_AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32_OUTPUT"
BETTER_AUTH_URL="http://localhost:3000"

# Origen del frontend (Vite) permitido para CORS y trustedOrigins de Better Auth
FRONTEND_URL="http://localhost:5173"

# --- App ---
PORT=3000

# --- SMTP (opcional) ---
# Sin estas variables, MailService queda en no-op (loguea un warning y no
# envía correo) — no rompen el boot de quien no las configure en su entorno.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SMI <no-reply@smi.local>"
SMTP_SECURE=false

# --- OCR (lectura de litros desde foto de surtidor: ensemble ONNX local
#          Florence-2 fine-tuned + CRNN, servido por un worker Python
#          persistente — ver src/ocr/ y ocr-python/README.md) ---

# Binario de python usado para lanzar ocr-python/worker.py. En el VPS:
# `apt install python3 python3-pip` + `pip install -r ocr-python/requirements.txt`
# (tesseract-ocr YA NO hace falta) y dejar el default "python3" (resuelto por
# PATH). En Windows local, apuntar al python 3.12 que tenga las deps
# instaladas (ver ocr-python/README.md), ej:
# PYTHON_BIN="C:/Users/<user>/AppData/Local/Programs/Python/Python312/python.exe"
PYTHON_BIN="python3"

# Carpeta con los 6 archivos de modelo (fuera de git — ver
# ocr-python/models.manifest.json y ocr-python/README.md "Setup"). Default
# si se omite: "<cwd>/ocr-python/models".
# OCR_MODELS_DIR="C:/ruta/a/smi-backend/ocr-python/models"

# Hilos para las sesiones ONNX de Florence + el pool de cv2 dentro del
# worker. Default 2 si se omite.
# OCR_THREADS=2

# Ruta a una foto real de surtidor para el test de integración OPCIONAL de
# OCR (`src/ocr/ocr.integration.spec.ts`) — sin esta var (o si el archivo no
# existe), ese test se salta automáticamente. NO commitear una foto real acá,
# es solo para desarrollo local.
# OCR_TEST_IMAGE="C:/ruta/a/tu/foto-surtidor.jpg"
