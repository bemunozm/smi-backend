# Copiar este archivo a `.env` y completar los valores para desarrollo local.
# NUNCA commitear el archivo `.env` real (ya está en .gitignore).

# --- Base de datos (Postgres via docker-compose) ---
# Puerto 5433 en el host (no 5432): evita choque con otros contenedores
# Postgres que puedan estar corriendo localmente. Ver docker-compose.yml.
DATABASE_URL="postgresql://smi_user:smi_password@localhost:5433/smi_db?schema=public"

# --- Better Auth ---
# Genera un secreto fuerte y único con: openssl rand -base64 32
# Nunca reutilizar este valor de ejemplo en un entorno real.
BETTER_AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32_OUTPUT"
BETTER_AUTH_URL="http://localhost:3000"

# Origen del frontend (Vite) permitido para CORS y trustedOrigins de Better Auth
FRONTEND_URL="http://localhost:5173"

# --- App ---
PORT=3000
