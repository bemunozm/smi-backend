// Prisma schema — tablas de autenticación (Better Auth) + modelos de dominio.
//
// Orden de las secciones:
//   1. Better Auth (Benjamín)      — generado por `npm run auth:schema`, no editar a mano.
//   2. Flota (Benjamín)            — Equipment, Branch (RFC T01, opción A — en inglés).
//   3. Inventario (Joaquín)        — InventoryItem, ItemCategory, Stock,
//                                    StockMovement, PartCompatibility (RFC-3).
//   4. Operación en Terreno (Alex) — RegistroCombustible, RegistroHorometro,
//                                    TrabajoExtraordinario, Hallazgo.
//
// Convenciones de este schema (guía §11 — migración gradual por módulo, cada
// dueño renombra su dominio a inglés al tocarlo):
//   - IDs: `String @id @default(cuid())` en TODAS las tablas de dominio.
//   - Enums Prisma para los vocabularios cerrados de Flota/Inventario. Las
//     columnas de Terreno siguen como `String` (decisión de su dueño); migrarlas
//     a enum es un cambio suyo, no mío.
//   - `user.role` sigue siendo String: lo exige el plugin `admin` de Better Auth.
//   - Referencias a usuarios (`responsableId`) son `String` SIN foreign key: la
//     tabla `user` la regenera el CLI de Better Auth y una back-relation nuestra
//     se perdería en la próxima regeneración.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Valores válidos: ADMIN | SUPERVISOR | MANTENEDOR (ver src/auth/roles.ts).
  /// El operador NO es un rol de usuario — es un catálogo propio (`Operator`,
  /// más abajo), sin acceso a la plataforma (RFC Supervisión en Terreno,
  /// anexo "el operador deja de ser usuario de la plataforma", 28/09).
  /// String (no enum Prisma) a propósito: el admin plugin de Better Auth tipa
  /// el rol como string dinámico; un enum Prisma introduciría fricción de tipos.
  role          String    @default("MANTENEDOR")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================================
// Núcleo (Benjamín): Notificaciones
// ============================================================================

/// Notificación in-app dirigida a un usuario. `userId` es soft ref a
/// `user.id` (mismo criterio que el resto del schema: la tabla `user` la
/// regenera el CLI de Better Auth). Alimentada por `NotificationsService` en
/// respuesta a los eventos de dominio (`common/events/domain-events.ts`).
model Notification {
  id        String   @id @default(cuid())
  userId    String // soft ref → user.id (destinatario)
  tipo      String
  titulo    String
  cuerpo    String
  data      Json?
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, leida])
  @@index([userId, createdAt])
  @@map("notification")
}

/// Trazabilidad de cambios a un registro ya enviado (Acta N.° 004, R13).
///
/// Editar un reporte o un trabajo extraordinario no pide autorización previa,
/// pero cada cambio deja una fila acá: quién, cuándo y qué dato pasó de qué
/// valor a cuál. Es genérica (`entity` + `entityId`, soft ref como en
/// `Notification`) para que la usen también el reporte diario y las tarjetas
/// de turno cuando tengan backend, sin una tabla por dominio.
///
/// `userName` se guarda como texto y no como relación: el registro tiene que
/// decir quién firmó el cambio aunque después le cambien el nombre al usuario.
model ChangeLog {
  id        String   @id @default(cuid())
  /// Qué tipo de registro se editó: `trabajo_extra`.
  entity    String
  entityId  String   @map("entity_id")
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  /// `[{ field, label, before, after }]`, con los valores ya legibles.
  changes   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId, createdAt])
  @@map("change_log")
}

// ============================================================================
// Dominio: Flota (Benjamín) — modelo rediseñado en inglés (RFC T01, opción A).
// El dominio de Inventario también quedó en inglés (RFC-3); su relación con la
// unidad apunta a `Equipment`.
// ============================================================================

/// Clase de la unidad — filtro principal de Flota (RFC T01 §2, R8).
enum EquipmentClass {
  LIGHT
  HEAVY
}

/// Discriminador de la unidad de control de uso de la máquina: kilometraje o
/// horómetro. Gobierna cuál de `currentMileage`/`currentHourmeter` aplica.
enum ControlUnit {
  KM
  HOURS
}

/// Estado operativo de una unidad (reemplaza al `EstadoEquipo` en español).
enum EquipmentStatus {
  OPERATIONAL
  IN_WORKSHOP
  OUT_OF_SERVICE
}

/// Sucursal / bodega. Referenciada por `Equipment.homeBranch` (base
/// operativa) y, a futuro, por `Stock`/`StockMovement` de Inventario.
model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  homedEquipment Equipment[]

  // Inventario (Joaquín, RFC-3). Las tres relaciones de movimiento son la misma
  // tabla vista desde tres ángulos: los asientos que mueven ESTA bodega, y los
  // traspasos en los que figura como origen o como destino.
  stocks         Stock[]
  stockMovements StockMovement[] @relation("StockMovementBranch")
  transfersOut   StockMovement[] @relation("StockMovementSource")
  transfersIn    StockMovement[] @relation("StockMovementDestination")

  @@map("branch")
}

model Equipment {
  id String @id @default(cuid())

  /// ID interno de la unidad (patente puede no existir en equipos pesados).
  /// Es el identificador que usa la operación en terreno, por eso es único y
  /// por el que se ordena/busca.
  internalCode String  @unique @map("internal_code")
  /// Patente. Nullable: equipos pesados (excavadoras, perforadoras…) suelen
  /// no tener.
  licensePlate String? @unique @map("license_plate")

  equipmentClass EquipmentClass @map("equipment_class")
  type           String
  brand          String
  model          String
  year           Int?

  controlUnit      ControlUnit @map("control_unit")
  /// Valor ACTUAL de uso de la máquina (guía §4): vive acá como columna, no
  /// como tabla. El historial de lecturas por turno es `RegistroHorometro`.
  /// Nullable y gobernado por `controlUnit`: solo uno de los dos aplica.
  currentHourmeter Float?      @map("current_hourmeter")
  currentMileage   Float?      @map("current_mileage")

  status EquipmentStatus @default(OPERATIONAL)

  homeBranchId String? @map("home_branch_id")
  homeBranch   Branch? @relation(fields: [homeBranchId], references: [id], onDelete: SetNull)

  /// Foto de la unidad (fidelidad 1:1 con el artefacto de Flota). Guarda la
  /// KEY del objeto en el bucket de storage (R2/MinIO, ver `StorageService`),
  /// NUNCA una URL — la URL firmada se resuelve on-read (`sign()`), nunca se
  /// persiste (ver Diseño del RFC R2-storage, "Contrato de la API").
  photoKey String? @map("photo_key")

  /// Asignación de uso ACTUAL de la unidad (operador + supervisor a cargo
  /// ahora mismo) — NO es historial de sesiones, eso queda como follow-up.
  /// `inUse` no es columna: se deriva en el service como `!!currentOperatorId`.
  ///
  /// `currentOperatorId` es FK REAL a `Operator` (RFC Supervisión en Terreno,
  /// anexo "el operador deja de ser usuario de la plataforma", 28/09): el
  /// operador es un catálogo propio nuestro, así que SÍ se permite la
  /// relación Prisma — a diferencia de `currentSupervisorId`, que sigue
  /// siendo un soft ref a `user.id` (String, SIN `@relation`, mismo criterio
  /// que el resto del schema: la tabla `user` la regenera `npm run
  /// auth:schema` y una relación real exigiría un campo inverso que ese
  /// generador no toca a mano — `EquipmentService` resuelve ese id → {id,name}
  /// con un `user.findMany` propio). `onDelete: SetNull` en ambos: borrar el
  /// operador/supervisor no debe borrar el equipo, solo liberar la
  /// asignación.
  currentOperatorId   String?   @map("current_operator_id")
  currentOperator     Operator? @relation(fields: [currentOperatorId], references: [id], onDelete: SetNull)
  currentSupervisorId String?   @map("current_supervisor_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Inventario (Joaquín, RFC-3)
  stockMovements      StockMovement[]
  partCompatibilities PartCompatibility[]

  // Operación en Terreno (Alexander)
  combustibles  RegistroCombustible[]
  horometros    RegistroHorometro[]
  trabajosExtra TrabajoExtraordinario[]
  hallazgos     Hallazgo[]

  /// Documentos del equipo (revisión técnica, seguro, permiso de circulación,
  /// certificaciones, otros) con archivo adjunto y CRUD propio — reemplaza
  /// las columnas planas `technicalInspectionExpiry`/`insuranceExpiry` (R1/R2)
  /// de la primera versión de Flota. Ver `EquipmentDocument`.
  documents EquipmentDocument[]

  @@index([equipmentClass])
  @@index([status])
  @@index([currentOperatorId])
  @@index([currentSupervisorId])
  @@map("equipment")
}

/// Tipo de documento de un `EquipmentDocument`. `TECHNICAL_INSPECTION`/
/// `INSURANCE` reemplazan a las columnas planas R1/R2 de la versión anterior;
/// `CIRCULATION_PERMIT`/`CERTIFICATION`/`OTHER` cubren los documentos que ya
/// se venían pidiendo pero no tenían dónde vivir.
enum EquipmentDocumentType {
  TECHNICAL_INSPECTION
  INSURANCE
  CIRCULATION_PERMIT
  CERTIFICATION
  OTHER
}

/// Documento de un equipo, con archivo adjunto (sube por `POST /api/files` +
/// claim en `EquipmentDocumentService`, ver Diseño del RFC R2-storage; acá
/// solo se guarda la KEY del objeto, nunca una URL) y vigencia opcional. A
/// diferencia de `currentHourmeter`/`photoKey` (dato ACTUAL de la ficha,
/// columna plana), un equipo puede tener VARIOS documentos del mismo tipo
/// (ej. dos certificaciones distintas) — de ahí la tabla propia con CRUD
/// dedicado en vez de columnas en `Equipment`. El estado de vigencia
/// (VIGENTE/POR_VENCER/VENCIDO/SIN_DATO) se deriva on-read en
/// `EquipmentDocumentService` (mismo `buildDocumentExpiryInfo` que antes vivía
/// en `EquipmentService`, ahora en `src/equipment/document-expiry.ts`), no se
/// persiste.
model EquipmentDocument {
  id String @id @default(cuid())

  equipmentId String    @map("equipment_id")
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  type       EquipmentDocumentType
  title      String?
  expiryDate DateTime?             @map("expiry_date")
  fileKey    String?               @map("file_key")
  /// Nombre "humano" del archivo (el que subió el usuario, ej. "Póliza
  /// Seguro.pdf") — se usa para el `Content-Disposition` al servir el
  /// archivo (`GET /api/equipment/documents/:id/file`), porque `fileKey` es
  /// un uuid sin significado para el usuario.
  fileName   String?               @map("file_name")
  notes      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([equipmentId])
  @@map("equipment_document")
}

// ============================================================================
// Dominio: Inventario (Joaquín) — RFC-3, opción A. Modelo en inglés.
//
// El cambio de fondo respecto del modelo anterior: la existencia deja de ser
// una columna del ítem y pasa a la tabla `Stock` (ítem × sucursal). No hay
// total denormalizado — el consolidado se calcula sumando `Stock`. Esa es la
// diferencia con el diseño previo (`Insumo.stock`), que obligaba a mantener dos
// números sincronizados a mano.
//
// ⚠️ ASUNCIÓN EXPLÍCITA DE T01 — SIN TRAZABILIDAD DE LOTE.
// RFC-3 dejó abierto "lote/serie/vencimiento (pendiente de Sima)". Este modelo
// se cierra asumiendo que NO se trazan: el saldo se identifica por
// (ítem × sucursal) y nada más.
//
// Si Sima confirma que hay que trazarlos, esto NO se resuelve agregando una
// columna: cambia la clave del saldo a (ítem × sucursal × lote), `Stock` pasa a
// tener una fila por lote, `StockMovement` necesita el lote, y el descuento
// tiene que elegir de cuál lote sale (FIFO / por vencimiento). Es una segunda
// migración y una reescritura del servicio de existencias, no un parche.
// Presupuestarlo así al replanificar.
// ============================================================================

enum UnitOfMeasure {
  UNIT
  LITER
  KILOGRAM
  METER
}

/// Suministro (consumible: aceite, grasa, huaipe) vs. repuesto (pieza que se
/// monta en una máquina). Gobierna las pestañas de la pantalla de Inventario
/// (T15) y qué ítems ofrece por defecto el buscador de compatibilidades.
enum ItemType {
  SUPPLY
  PART
}

/// Agrupación libre del catálogo (Filtros, Lubricantes, Neumáticos…). Tabla y
/// no enum: la mantiene el administrador desde la aplicación, sin migración.
model ItemCategory {
  id   String @id @default(cuid())
  name String @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items InventoryItem[]

  @@map("item_category")
}

model InventoryItem {
  id          String        @id @default(cuid())
  /// Código interno del catálogo (ex `Insumo.codigo`).
  sku         String        @unique
  name        String
  description String?
  unit        UnitOfMeasure @default(UNIT)
  type        ItemType      @default(SUPPLY)

  categoryId String?       @map("category_id")
  category   ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Número de parte del fabricante. Es lo que el mecánico tiene a la vista
  /// cuando sostiene la pieza, y no coincide con nuestro `sku`.
  partNumber      String? @map("part_number")
  defaultSupplier String? @map("default_supplier")
  /// Su falta detiene la máquina: la UI lo destaca y el reporte de compras lo
  /// prioriza aunque el saldo todavía no cruce el mínimo.
  isCritical      Boolean @default(false) @map("is_critical")
  /// Baja lógica. El catálogo no se borra: los movimientos históricos lo
  /// referencian y el kardex tiene que seguir siendo legible.
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stocks          Stock[]
  movements       StockMovement[]
  compatibilities PartCompatibility[]

  @@index([name])
  @@index([type])
  @@map("inventory_item")
}

/// Existencia de un ítem EN una sucursal. Es la ÚNICA fuente de verdad del
/// saldo: no hay columna espejo en `InventoryItem`, así que no hay dos números
/// que puedan discrepar.
///
/// Un ítem sin fila en una sucursal se lee como saldo 0; la fila se crea
/// (upsert) en el primer movimiento que ocurre en esa bodega.
model Stock {
  id     String        @id @default(cuid())
  itemId String        @map("item_id")
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  quantity Float @default(0)

  /// Umbral de reposición PROPIO de esta bodega. `0` = no configurado, y por lo
  /// tanto no alerta. El umbral de la empresa y el de una bodega no son la
  /// misma magnitud: usar uno como el otro enciende la alerta en todas las
  /// filas a la vez, que es peor que no alertar.
  minimumQuantity Float @default(0) @map("minimum_quantity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([itemId, branchId])
  @@index([branchId])
  @@map("stock")
}

/// Dirección del asiento. El ajuste por conteo físico NO es una dirección
/// aparte: se registra como IN u OUT con `reason = PHYSICAL_ADJUSTMENT` según
/// el signo de la diferencia. Así `quantity` es SIEMPRE positiva.
enum MovementDirection {
  IN
  OUT
}

/// Por qué se movió el saldo.
enum MovementReason {
  PURCHASE // Entrada / reposición
  RETURN // Material no usado que vuelve a bodega
  PHYSICAL_ADJUSTMENT // Corrección tras conteo físico
  INTERVENTION // Consumo por mantención
  ACTIVITY // Consumo por actividad/tarea
  EXTRAORDINARY_WORK // Consumo en un trabajo facturable
  TRANSFER // Traspaso entre sucursales (RFC-3 D4: dos asientos)
}

/// Kardex: un asiento por cada entrada/salida, con el saldo resultante.
///
/// Un traspaso son DOS asientos (OUT en el origen + IN en el destino) que
/// comparten `reference` y llevan `reason = TRANSFER`. Se modela así, y no como
/// una fila con dos sucursales, para que el saldo de cada bodega se derive
/// leyendo únicamente sus propios asientos.
model StockMovement {
  id     String        @id @default(cuid())
  itemId String        @map("item_id")
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Bodega cuyo saldo mueve ESTE asiento. `Restrict` y no `Cascade`: dar de
  /// baja una sucursal no puede llevarse su historial por delante.
  branchId String @map("branch_id")
  branch   Branch @relation("StockMovementBranch", fields: [branchId], references: [id], onDelete: Restrict)

  direction MovementDirection
  reason    MovementReason

  /// Siempre > 0. El signo lo determina `direction`.
  quantity         Float
  /// Saldo del ítem EN ESTA BODEGA después de aplicar el asiento, calculado
  /// dentro de la misma transacción. Denormalizado a propósito: deja evidencia
  /// auditable del saldo en cada punto sin recalcular la serie completa.
  resultingBalance Float @map("resulting_balance")

  /// Vínculo del asiento con lo que lo originó. Su significado lo determina
  /// `reason`: en un TRANSFER agrupa los dos asientos del par; en un consumo
  /// apunta al documento de origen (intervención, actividad…). String suelto:
  /// una FK polimórfica no se puede expresar en Prisma.
  reference String?

  /// El papel que respalda el movimiento: guía de despacho, orden de compra,
  /// factura. Lo escribe quien registra, y es distinto de `reference` — ese es
  /// un vínculo interno del sistema (el folio que aparea los dos asientos de un
  /// traspaso), y meter ahí el número de guía haría que un traspaso no pudiera
  /// tener las dos cosas a la vez.
  documentNumber String? @map("document_number")

  /// Contraparte del traspaso, para que cada renglón del kardex se explique
  /// solo ("salida hacia Faena Norte" / "entrada desde Casa Matriz"). Nulos
  /// fuera de un TRANSFER.
  sourceBranchId      String? @map("source_branch_id")
  sourceBranch        Branch? @relation("StockMovementSource", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  destinationBranchId String? @map("destination_branch_id")
  destinationBranch   Branch? @relation("StockMovementDestination", fields: [destinationBranchId], references: [id], onDelete: Restrict)

  /// `user.id` de Better Auth. Sin FK — ver nota de convenciones arriba.
  performedById String? @map("performed_by_id")

  /// Unidad a la que se imputa el consumo, si aplica. `SetNull` y no `Cascade`:
  /// borrar un equipo no debe borrar el historial de stock.
  equipmentId String?    @map("equipment_id")
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  notes      String?
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([itemId, occurredAt])
  @@index([branchId, occurredAt])
  @@index([equipmentId])
  @@index([reference])
  @@map("stock_movement")
}

/// Qué repuestos sirven para qué máquina. N:M con FK reales en ambos lados a
/// propósito: es lo que permite el join "compatible con este equipo Y con
/// existencia en mi bodega", que es la consulta con valor operativo. Una regla
/// por marca/modelo no se podría cruzar con el saldo de forma confiable, porque
/// `Equipment.brand`/`model` son texto libre sin catálogo ni normalización.
model PartCompatibility {
  id          String        @id @default(cuid())
  equipmentId String        @map("equipment_id")
  equipment   Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  itemId      String        @map("item_id")
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Salvedad de la compatibilidad: "solo desde nº serie 4500", "requiere
  /// adaptador". Es el conocimiento que hoy vive en la cabeza del mecánico.
  note String?

  /// `user.id` de Better Auth de quien la declaró — sin FK.
  declaredById String? @map("declared_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Una máquina no declara dos veces el mismo repuesto: la replicación por
  /// marca+modelo se apoya en esto para ser idempotente.
  @@unique([equipmentId, itemId])
  @@index([itemId])
  @@map("part_compatibility")
}

// ============================================================================
// Dominio: Operación en Terreno (Alexander)
// Las relaciones ahora apuntan al `Equipment` real de Flota. Los modelos de
// abajo no fueron modificados salvo por eso.
// ============================================================================

model RegistroCombustible {
  id       String    @id @default(cuid())
  equipoId String    @map("equipo_id")
  equipo   Equipment @relation(fields: [equipoId], references: [id])
  litros   Float
  tipo     String // PETROLEO | BENCINA
  fotoUrl  String? // legacy: URL servida por /api/uploads (Terreno, sigue viva)
  /// Key del objeto en el bucket de storage (R2/MinIO), aditiva sobre
  /// `fotoUrl` legacy — ver Diseño del RFC R2-storage, "Combustible". Sin
  /// `@map` a propósito: este modelo, igual que el resto de Terreno, no sigue
  /// la convención snake_case del resto del schema (ver comentario de
  /// cabecera de esta sección).
  /// ADVERTENCIA (info, auditoría de seguridad): cuando esta carga nació de
  /// un cierre de tarjeta (`registroHorometroId` no nulo), esta key es LA
  /// MISMA que `RegistroHorometro.pumpPhotoKey` de esa tarjeta — ver la
  /// advertencia espejo ahí.
  fotoKey  String?
  fecha    DateTime  @default(now())

  /// Vínculo 1:1 opcional con la tarjeta de turno que originó esta carga
  /// (RFC Supervisión en Terreno, Fase 1): al cerrar una tarjeta con
  /// `fuelLiters > 0`, Fase 2 crea ACÁ la carga con la misma `pumpPhotoKey`
  /// del cierre, para que aparezca sola en la ficha y en el historial de
  /// combustible sin duplicar la foto. `SetNull` y no `Cascade`: borrar la
  /// tarjeta (excepcional) no debe arrastrarse la carga ya registrada.
  registroHorometroId String?            @unique @map("registro_horometro_id")
  registroHorometro   RegistroHorometro? @relation(fields: [registroHorometroId], references: [id], onDelete: SetNull)
}

/// Tarjeta de turno de Supervisión en Terreno (RFC Supervisión en Terreno,
/// Fase 1 — schema/migración; los endpoints `POST /api/shift-cards*` son
/// Fase 2). El modelo reutilizado es `RegistroHorometro` (no una tabla
/// nueva): el índice único parcial `RegistroHorometro_equipo_id_open_turno_key`
/// (ver migración `20260921153343_horometro_open_turno_unique_index`) ya
/// garantiza un solo turno abierto por equipo a nivel de base de datos, y
/// `reconcileEquipmentCounter`/`openShift`/la ficha ya lo consumen.
///
/// El PK sigue siendo `id String @default(cuid())` a propósito: Fase 2 pasa a
/// generarlo desde el cliente (UUID v4, para que "abrir tarjeta" sea
/// idempotente sin ida y vuelta al servidor) — ese cambio de estrategia de
/// generación no requiere migración de schema, solo que el caller mande el
/// `id`.
model RegistroHorometro {
  id               String    @id @default(cuid())
  equipoId         String    @map("equipo_id")
  equipo           Equipment @relation(fields: [equipoId], references: [id])
  operador         String // nombre y apellido — snapshot; ver `operatorId` para el catálogo
  turno            String // DIURNO | NOCTURNO
  valorInicial     Float
  valorFinal       Float?
  nivelCombustible Float? // % de combustible
  fecha            DateTime  @default(now()) // hora de ENTRADA (reloj del dispositivo)

  /// Flujo ENTRADA/SALIDA en dos pasos (Flota): "turno abierto" = `valorFinal
  /// == null`. Al cerrar (`PATCH /horometro/:id/salida`, o `POST
  /// /api/shift-cards/:id/close` en Fase 2) se completa este campo junto con
  /// `valorFinal` — queda `null` mientras el turno está abierto.
  fechaSalida DateTime? // hora de SALIDA (reloj del dispositivo)

  /// Turno (Módulo A/B) al que pertenece esta tarjeta. `SetNull` y no
  /// `Cascade`: un `Shift` no se borra en la operación normal, pero si
  /// alguna vez se limpia uno viejo, la tarjeta no debe desaparecer con él.
  shiftId String? @map("shift_id")
  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  /// Supervisor que abrió la tarjeta — soft ref a `user.id` (sin FK, mismo
  /// criterio que el resto del schema: la tabla `user` la regenera el CLI de
  /// Better Auth). Se graba en el create vía `@Session()` (Fase 2).
  supervisorId String? @map("supervisor_id")

  /// Operador del catálogo propio (`Operator`), aditivo sobre `operador`
  /// (que se mantiene como snapshot de texto — el nombre no cambia con
  /// retroactividad si el operador se renombra o desactiva después).
  /// `SetNull`: desactivar/borrar un operador no debe borrar el historial de
  /// tarjetas que lo referencian.
  operatorId String?   @map("operator_id")
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  /// Litros cargados al cierre (Módulo A). Mismo tipo que
  /// `RegistroCombustible.litros` — si es > 0, Fase 2 crea la carga
  /// vinculada (`RegistroCombustible.registroHorometroId`) con esta misma
  /// `pumpPhotoKey`.
  fuelLiters    Float?  @map("fuel_liters")
  /// Key del objeto en el bucket de storage (R2/MinIO) de la foto del
  /// surtidor/horómetro al cierre. Reemplaza a `fotoUrlSalida` (legacy,
  /// pública, eliminada en esta misma migración) — nunca una URL, se firma
  /// on-read igual que el resto de Flota (ver `StorageService.sign`).
  /// ADVERTENCIA (info, auditoría de seguridad): cuando `fuelLiters > 0`,
  /// `RegistroCombustible.fotoKey` de la carga vinculada (ver
  /// `registroHorometroId` más abajo) apunta a ESTE MISMO objeto — no es una
  /// copia. Cualquier borrado/reemplazo futuro de esta key (ej. un endpoint
  /// que permita re-subir la foto de cierre) tiene que considerar TAMBIÉN la
  /// fila de `RegistroCombustible`, o esa carga queda apuntando a un objeto
  /// borrado.
  pumpPhotoKey  String? @map("pump_photo_key")
  /// Observaciones libres del supervisor al cierre.
  observaciones String?

  /// UUID generado por el cliente al cerrar la tarjeta (Fase 2): permite que
  /// un reintento de "cerrar" (por red offline) sea idempotente — releer por
  /// este id en vez de volver a aplicar el cierre. `@unique` es la garantía
  /// dura contra dos cierres con clientClientId distintos coincidiendo.
  closeClientId String? @unique @map("close_client_id")

  /// `true` cuando el valor inicial ingresado por el supervisor fue MENOR que
  /// el contador vigente del equipo y el modo warn (Fase 2) lo aceptó sin
  /// mover el contador ni rechazar — auditoría de una posible lectura
  /// errónea, no un bloqueo.
  belowPreviousReading Boolean @default(false) @map("below_previous_reading")

  /// Horas de servidor (auditoría), independientes de `fecha`/`fechaSalida`
  /// (reloj del dispositivo, que puede estar desfasado sin señal).
  createdAt DateTime  @default(now()) @map("created_at")
  closedAt  DateTime? @map("closed_at")

  /// Desfase detectado entre el reloj del dispositivo y el del servidor al
  /// abrir/cerrar (`clientTimestamp - serverTimestamp`, en ms) — se audita,
  /// nunca se usa para rechazar salvo que sea absurdo (Fase 2: > 24 h futuro
  /// o > 7 días de antigüedad).
  clientClockSkewMs Int? @map("client_clock_skew_ms")

  /// Carga de combustible 1:1 creada al cierre cuando `fuelLiters > 0` (ver
  /// comentario de `RegistroCombustible.registroHorometroId`).
  combustible RegistroCombustible?

  @@index([shiftId])
  @@index([supervisorId])
}

/// Turno de Supervisión en Terreno: agrupa las tarjetas (`RegistroHorometro`)
/// que un supervisor abre en una fecha+tipo de turno. Clave natural
/// `(supervisorId, date, type)` — Fase 2 lo crea con upsert por esa clave al
/// abrir la primera tarjeta del turno, nunca con un endpoint `createShift`
/// propio. Contrato compartido con el Módulo B (reporte diario, Alexander).
model Shift {
  id   String   @id @default(cuid())
  /// Sin hora: el turno es "el día X", no un instante. La API lo sirve como
  /// string `YYYY-MM-DD` (Fase 2, capa de servicio) — acá es `@db.Date` para
  /// que dos turnos del mismo día no puedan diferir por zona horaria.
  date DateTime @db.Date
  /// DIURNO | NOCTURNO — `String` y no enum Prisma, mismo criterio que
  /// `RegistroHorometro.turno` (columnas de Terreno, decisión de su dueño;
  /// ver comentario de cabecera del schema).
  type String

  /// Soft ref a `user.id` — mismo criterio que `RegistroHorometro.supervisorId`.
  supervisorId String @map("supervisor_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cards       RegistroHorometro[]
  exitReports ShiftExitReport[]

  @@unique([supervisorId, date, type])
  @@map("shift")
}

/// Reporte de salida de turno (Módulo A, Fase 3: PDF + envío). El PK es el
/// UUID que genera el cliente al pedir el reporte (idempotencia: reintentar
/// con el mismo id devuelve el mismo reporte en vez de generar el PDF de
/// nuevo). Un `Shift` puede tener MÁS de un reporte — se permite reenviar si
/// se agregan tarjetas después del primer envío.
model ShiftExitReport {
  id      String @id
  shiftId String @map("shift_id")
  shift   Shift  @relation(fields: [shiftId], references: [id])

  fileKey   String @map("file_key")
  fileName  String @map("file_name")
  cardCount Int    @map("card_count")

  /// Hora del dispositivo al pedir el reporte (puede diferir de `createdAt`,
  /// hora de servidor, si se generó offline y se reintentó después).
  requestedAt DateTime @map("requested_at")
  createdAt   DateTime @default(now()) @map("created_at")
  /// Soft ref a `user.id` de quien pidió el reporte.
  createdById String   @map("created_by_id")

  /// PENDING | SENT | FAILED | SKIPPED — `String` y no enum Prisma, mismo
  /// criterio que el resto de vocabularios de Terreno en este schema.
  emailStatus String    @default("PENDING") @map("email_status")
  notifiedAt  DateTime? @map("notified_at")

  @@index([shiftId])
  @@map("shift_exit_report")
}

/// Catálogo propio de operadores de Supervisión en Terreno (RFC, decisión
/// 28/09: "Operadores = catálogo propio"), reemplaza el arreglo
/// `OPERADORES` hardcodeado en `RegistroEquipoView.tsx` del frontend. CRUD
/// clonado de `src/branch/*`: lectura abierta a cualquier sesión, escritura
/// ADMIN/SUPERVISOR, borrado ADMIN con guarda de uso (409 si algún
/// `RegistroHorometro` lo referencia).
model Operator {
  id       String  @id @default(cuid())
  name     String
  /// RUT chileno normalizado `12345678-K`, validado con dígito verificador
  /// en el DTO (no acá: Prisma no valida formato). Opcional hasta que llegue
  /// la nómina real del cliente (seed sin RUT).
  rut      String? @unique
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  horometros RegistroHorometro[]

  /// Asignación de uso ACTUAL de Flota (`Equipment.currentOperatorId`, RFC
  /// Supervisión en Terreno, anexo "el operador deja de ser usuario de la
  /// plataforma") — inverso de la FK real agregada en esa migración.
  assignedEquipment Equipment[]

  /// Trabajos extraordinarios asignados a este operador del catálogo (RFC
  /// Supervisión en Terreno, Anexo 2 "operador del catálogo en Trabajos
  /// extra") — inverso de `TrabajoExtraordinario.operatorId`.
  trabajosExtra TrabajoExtraordinario[]

  @@map("operator")
}

model TrabajoExtraordinario {
  id               String    @id @default(cuid())
  equipoId         String    @map("equipo_id")
  equipo           Equipment @relation(fields: [equipoId], references: [id])
  operador         String // nombre y apellido — snapshot armado por el SERVIDOR; ver `operatorId` para el catálogo
  /// Operador del catálogo propio (`Operator`), aditivo sobre `operador`
  /// (que se mantiene como snapshot de texto, igual que en `RegistroHorometro`
  /// — el nombre no cambia con retroactividad si el operador se renombra o
  /// desactiva después). Nullable por las filas legacy (texto libre sin match
  /// determinístico en el catálogo, ver migración de backfill); para las
  /// filas NUEVAS es obligatorio a nivel de servicio
  /// (`CreateTrabajoExtraDto.operatorId`) — el cliente ya no puede mandar
  /// `operador` directamente (RFC Supervisión en Terreno, Anexo 2). `SetNull`:
  /// borrar/desactivar un operador no debe borrar el historial de trabajos
  /// que lo referencian.
  operatorId       String?   @map("operator_id")
  operator         Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  faena            String
  turno            String // DIURNO | NOCTURNO
  horometroInicial Float
  horometroFinal   Float
  totalHoras       Float
  /// Actividades del trabajo. Son VARIAS: la especificación del 21/09 pide
  /// multi-selección, porque una misma salida suele mezclar tareas — soltar
  /// material y después limpiar la cancha es un trabajo, no dos.
  /// Valores: REGULACION_CARGA | LIMPIEZA_CANCHA | SOLTAR_MATERIAL |
  /// LIMPIEZA_SILOS | HACER_PETRIL | ARREGLO_CANCHA.
  actividades      String[]
  /// Texto libre de la opción «Otro», para la tarea que no estaba en la lista.
  /// Null cuando no se eligió «Otro». El catálogo administrable que pide R7 es
  /// un paso posterior; esto es la válvula de escape mientras tanto.
  otraActividad    String?   @map("otra_actividad")
  descripcion      String
  observaciones    String?
  fecha            DateTime  @default(now())

  @@index([operatorId])
}

model Hallazgo {
  id          String    @id @default(cuid())
  equipoId    String    @map("equipo_id")
  equipo      Equipment @relation(fields: [equipoId], references: [id])
  descripcion String
  prioridad   String // BAJA | MEDIA | ALTA | CRITICA
  estado      String    @default("ABIERTO") // ABIERTO | EN_PROCESO | CERRADO
  fotoUrl     String? // legacy: URL servida por /api/uploads (Terreno, sigue viva)
  /// Key del objeto en el bucket de storage (R2/MinIO), aditiva sobre
  /// `fotoUrl` legacy — mismo patrón que `RegistroCombustible`. Los hallazgos
  /// ya cargados conservan su `fotoUrl` y se siguen viendo; los nuevos suben
  /// por `POST /api/files` y guardan la key.
  fotoKey     String?
  fecha       DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// 4. Dominio Mantenimiento (dueño: Joaquín). Órdenes de trabajo, bitácora de
// intervención, motor preventivo y actividades.
//
// Referencias a otros dominios (equipoId → Equipo de Flota, insumoId → Insumo
// de Inventario, hallazgoId → Hallazgo de Terreno, asignadoAId/realizadaPorId →
// user.id de Better Auth) se mantienen como "soft refs": String sin relación
// Prisma. Esas tablas ya existen, pero se dejan desacopladas por ahora para no
// atar esta migración a las de Flota/Inventario/Terreno; convertirlas a FK real
// es un cambio a coordinar con Amin/Alexander. Relaciones Prisma reales SOLO
// entre tablas propias de este dominio.
// ---------------------------------------------------------------------------

enum EstadoOT {
  PENDIENTE
  ASIGNADA
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum TipoOT {
  CORRECTIVA
  PREVENTIVA
}

enum OrigenOT {
  MANUAL
  PREVENTIVO
  HALLAZGO
}

enum PrioridadOT {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoActividad {
  PENDIENTE
  COMPLETADA
}

enum OrigenActividad {
  HALLAZGO
  EQUIPO
  MANUAL
}

model OrdenTrabajo {
  id             String         @id @default(cuid())
  equipoId       String // soft ref → Equipo (Flota/Amin)
  asignadoAId    String? // soft ref → user.id
  titulo         String
  estado         EstadoOT       @default(PENDIENTE)
  prioridad      PrioridadOT    @default(MEDIA)
  tipo           TipoOT         @default(CORRECTIVA)
  origen         OrigenOT       @default(MANUAL)
  origenDetalle  String?
  tareas         TareaOT[]
  intervenciones Intervencion[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([estado])
  @@index([equipoId])
  @@map("orden_trabajo")
}

model TareaOT {
  id       String       @id @default(cuid())
  ordenId  String
  orden    OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  texto    String
  hecha    Boolean      @default(false)
  posicion Int          @default(0)

  @@index([ordenId])
  @@map("tarea_ot")
}

model Intervencion {
  id             String               @id @default(cuid())
  ordenId        String
  orden          OrdenTrabajo         @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  tipo           TipoOT               @default(CORRECTIVA)
  detalle        String
  horasHombre    Float                @default(0)
  horometro      Float?
  realizadaPorId String? // soft ref → user.id
  soloLectura    Boolean              @default(false)
  insumos        IntervencionInsumo[]
  fecha          DateTime             @default(now())

  @@index([ordenId])
  @@map("intervencion")
}

model IntervencionInsumo {
  id             String       @id @default(cuid())
  intervencionId String
  intervencion   Intervencion @relation(fields: [intervencionId], references: [id], onDelete: Cascade)
  insumoId       String // soft ref → Insumo (Inventario/Amin)
  cantidad       Int

  @@index([intervencionId])
  @@map("intervencion_insumo")
}

model UmbralMantenimiento {
  id             String @id @default(cuid())
  tipoEquipo     String
  tipoMantencion String
  umbralHoras    Int

  @@map("umbral_mantenimiento")
}

model Actividad {
  id          String          @id @default(cuid())
  descripcion String
  origen      OrigenActividad @default(MANUAL)
  referencia  String?
  asignadoAId String? // soft ref → user.id
  equipoId    String? // soft ref → Equipo
  hallazgoId  String? // soft ref → Hallazgo (Terreno)
  estado      EstadoActividad @default(PENDIENTE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("actividad")
}
