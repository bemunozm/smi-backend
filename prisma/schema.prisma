// Prisma schema — tablas de autenticación (Better Auth) + modelos de dominio.
// Cada dev agrega SOLO los modelos de su propio dominio (ver CLAUDE.md
// § "schema.prisma — zona sensible"). El `Equipo` de Terreno es PROVISIONAL
// (dueño real: Amin/Flota); se reconcilia cuando suba el módulo real de Flota.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Valores válidos: ADMIN | SUPERVISOR | MANTENEDOR | OPERADOR (ver src/auth/roles.ts).
  /// String (no enum Prisma) a propósito: el admin plugin de Better Auth tipa
  /// el rol como string dinámico; un enum Prisma introduciría fricción de tipos.
  role          String    @default("OPERADOR")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Dominio Mantenimiento (dueño: Joaquín). Referencias a otros dominios
// (equipoId → Equipo de Flota/Amin, insumoId → Insumo de Inventario/Amin,
// asignadoAId/realizadaPorId → user.id de Better Auth, hallazgoId → Hallazgo
// de Terreno) son "soft refs": strings sin relación Prisma, porque esas
// tablas son de otros dueños y todavía no existen (o, en el caso de `user`,
// no se agrega back-relation para no acoplar el modelo de Auth a este
// dominio). Relaciones Prisma reales SOLO entre tablas propias de este
// dominio (OrdenTrabajo/TareaOT/Intervencion/IntervencionInsumo).
// ---------------------------------------------------------------------------

enum EstadoOT {
  PENDIENTE
  ASIGNADA
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum TipoOT {
  CORRECTIVA
  PREVENTIVA
}

enum OrigenOT {
  MANUAL
  PREVENTIVO
  HALLAZGO
}

enum PrioridadOT {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoActividad {
  PENDIENTE
  COMPLETADA
}

enum OrigenActividad {
  HALLAZGO
  EQUIPO
  MANUAL
}

model OrdenTrabajo {
  id             String         @id @default(cuid())
  equipoId       String // soft ref → Equipo (Flota/Amin), sin FK aún
  asignadoAId    String? // soft ref → user.id
  titulo         String
  estado         EstadoOT       @default(PENDIENTE)
  prioridad      PrioridadOT    @default(MEDIA)
  tipo           TipoOT         @default(CORRECTIVA)
  origen         OrigenOT       @default(MANUAL)
  origenDetalle  String?
  tareas         TareaOT[]
  intervenciones Intervencion[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([estado])
  @@index([equipoId])
  @@map("orden_trabajo")
}

model TareaOT {
  id       String       @id @default(cuid())
  ordenId  String
  orden    OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  texto    String
  hecha    Boolean      @default(false)
  posicion Int          @default(0)

  @@index([ordenId])
  @@map("tarea_ot")
}

model Intervencion {
  id             String               @id @default(cuid())
  ordenId        String
  orden          OrdenTrabajo         @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  tipo           TipoOT               @default(CORRECTIVA)
  detalle        String
  horasHombre    Float                @default(0)
  horometro      Float?
  realizadaPorId String? // soft ref → user.id
  soloLectura    Boolean              @default(false)
  insumos        IntervencionInsumo[]
  fecha          DateTime             @default(now())

  @@index([ordenId])
  @@map("intervencion")
}

model IntervencionInsumo {
  id             String       @id @default(cuid())
  intervencionId String
  intervencion   Intervencion @relation(fields: [intervencionId], references: [id], onDelete: Cascade)
  insumoId       String // soft ref → Insumo (Inventario/Amin), sin FK aún
  cantidad       Int

  @@index([intervencionId])
  @@map("intervencion_insumo")
}

model UmbralMantenimiento {
  id             String @id @default(cuid())
  tipoEquipo     String
  tipoMantencion String
  umbralHoras    Int

  @@map("umbral_mantenimiento")
}

model Actividad {
  id          String          @id @default(cuid())
  descripcion String
  origen      OrigenActividad @default(MANUAL)
  referencia  String?
  asignadoAId String? // soft ref → user.id
  equipoId    String? // soft ref → Equipo
  hallazgoId  String? // soft ref → Hallazgo (Terreno)
  estado      EstadoActividad @default(PENDIENTE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("actividad")
}

// ============================================================================
// Dominio: Operación en Terreno (Alexander)
// PROVISIONAL: el modelo `Equipo` es un placeholder hasta que Amin (Flota)
// suba el real; entonces se reconcilian estas relaciones.
// ============================================================================

model Equipo {
  id                String @id @default(cuid())
  codigo            String @unique
  tipo              String
  marca             String
  modelo            String
  estado            String @default("OPERATIVO") // OPERATIVO | DETENIDO | MANTENIMIENTO
  horometroActual   Float  @default(0)
  kilometrajeActual Float  @default(0)

  combustibles  RegistroCombustible[]
  horometros    RegistroHorometro[]
  trabajosExtra TrabajoExtraordinario[]
  hallazgos     Hallazgo[]
}

model RegistroCombustible {
  id       String   @id @default(cuid())
  equipoId String
  equipo   Equipo   @relation(fields: [equipoId], references: [id])
  litros   Float
  tipo     String // PETROLEO | BENCINA
  fotoUrl  String?
  fecha    DateTime @default(now())
}

model RegistroHorometro {
  id               String   @id @default(cuid())
  equipoId         String
  equipo           Equipo   @relation(fields: [equipoId], references: [id])
  operador         String // nombre y apellido
  turno            String // DIURNO | NOCTURNO
  valorInicial     Float
  valorFinal       Float?
  nivelCombustible Float? // % de combustible
  fecha            DateTime @default(now())
}

model TrabajoExtraordinario {
  id               String   @id @default(cuid())
  equipoId         String
  equipo           Equipo   @relation(fields: [equipoId], references: [id])
  operador         String
  faena            String
  turno            String // DIURNO | NOCTURNO
  horometroInicial Float
  horometroFinal   Float
  totalHoras       Float
  actividad        String // REGULACION_CARGA | LIMPIEZA_CANCHA | SOLTAR_MATERIAL | LIMPIEZA_SILOS | HACER_PETRIL | ARREGLO_CANCHA
  descripcion      String
  observaciones    String?
  fecha            DateTime @default(now())
}

model Hallazgo {
  id          String   @id @default(cuid())
  equipoId    String
  equipo      Equipo   @relation(fields: [equipoId], references: [id])
  descripcion String
  prioridad   String // BAJA | MEDIA | ALTA | CRITICA
  estado      String   @default("ABIERTO") // ABIERTO | EN_PROCESO | CERRADO
  fotoUrl     String?
  fecha       DateTime @default(now())
}
