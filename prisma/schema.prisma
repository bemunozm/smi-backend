generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// PROVISIONAL — dueño real: Amin (Flota). Placeholder mínimo para resolver relaciones.
model Equipo {
  id                String   @id @default(cuid())
  codigo            String   @unique
  tipo              String
  marca             String
  modelo            String
  estado            String   @default("OPERATIVO") // OPERATIVO | DETENIDO | MANTENIMIENTO
  horometroActual   Float    @default(0)
  kilometrajeActual Float    @default(0)

  combustibles  RegistroCombustible[]
  horometros    RegistroHorometro[]
  trabajosExtra TrabajoExtraordinario[]
  hallazgos     Hallazgo[]
}

model RegistroCombustible {
  id       String   @id @default(cuid())
  equipoId String
  equipo   Equipo   @relation(fields: [equipoId], references: [id])
  litros   Float
  tipo     String // PETROLEO | BENCINA
  fotoUrl  String?
  fecha    DateTime @default(now())
}

model RegistroHorometro {
  id               String   @id @default(cuid())
  equipoId         String
  equipo           Equipo   @relation(fields: [equipoId], references: [id])
  operador         String // nombre y apellido
  turno            String // DIURNO | NOCTURNO
  valorInicial     Float
  valorFinal       Float?
  nivelCombustible Float? // % de combustible
  fecha            DateTime @default(now())
}

model TrabajoExtraordinario {
  id               String   @id @default(cuid())
  equipoId         String
  equipo           Equipo   @relation(fields: [equipoId], references: [id])
  operador         String
  faena            String
  turno            String // DIURNO | NOCTURNO
  horometroInicial Float
  horometroFinal   Float
  totalHoras       Float
  actividad        String // regulacion-carga | limpieza-cancha | soltar-material | limpieza-silos | hacer-petril | arreglo-cancha
  descripcion      String
  observaciones    String?
  fecha            DateTime @default(now())
}

model Hallazgo {
  id          String   @id @default(cuid())
  equipoId    String
  equipo      Equipo   @relation(fields: [equipoId], references: [id])
  descripcion String
  prioridad   String // BAJA | MEDIA | ALTA | CRITICA
  estado      String   @default("ABIERTO") // ABIERTO | EN_PROCESO | CERRADO
  fotoUrl     String?
  fecha       DateTime @default(now())
}
